# Airflow Crypto BTC - Configuration
# Copy to .env and adjust as needed

# Data directory for SQLite DB and CSV files
DATA_DIR=/opt/airflow/data

# Directory for generated PNG reports
REPORTS_DIR=/opt/airflow/include/reports

# Airflow credentials (override defaults)
# AIRFLOW_UID=50000
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
